# Copy this file to .env and adjust the values. .env is git-ignored and must never be committed.

# SQL Server sa password. Must be at least 8 characters and contain characters
# from at least three of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=ChangeMe_Strong1!

# Host port published to the SQL Server container. Keep 1433 unless another
# instance (e.g. a pre-existing sqlserver22 container) already uses it; in that
# case pick a free port such as 14331 for rehearsals.
MSSQL_PORT=1433
