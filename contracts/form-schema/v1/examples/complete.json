          "variable": "CantidadHombres", "label": "Cantidad de hombres", "order": 1, "core": true,
          "validation": { "min": 0, "max": 10 }
        },
        {
          "id": "cantidad_mujeres", "type": "field", "component": "number",
          "variable": "CantidadMujeres", "label": "Cantidad de mujeres", "order": 2, "core": true,
          "validation": {}
