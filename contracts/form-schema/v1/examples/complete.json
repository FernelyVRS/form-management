          "order": 1,
          "core": true,
          "dependency": { "field": "NivelGradoMasAltoAp" },
          "map": {
            "1": [{ "label": "Primero", "value": "1" }, { "label": "No sabe", "value": "98" }],
            "2": [{ "label": "Primero", "value": "1" }, { "label": "Segundo", "value": "2" }]
          }
        },
        {
          "id": "datos_personales",
          "type": "group",
          "label": "Datos personales",
          "description": "Datos de la persona entrevistada.",
          "order": 2,
          "items": [
            {
              "id": "nombre", "type": "field", "component": "text",
              "variable": "Nombre", "label": "Nombres", "order": 1, "core": true,
              "validation": { "maxLength": 10 }
            },
            {
              "id": "apellido", "type": "field", "component": "text",
              "variable": "Apellidos", "label": "Apellidos", "order": 2, "core": true
            },
            {
              "id": "edad", "type": "field", "component": "number",
              "variable": "Edad", "label": "Edad", "order": 3, "core": true,
              "validation": { "min": 0, "max": 115 }
