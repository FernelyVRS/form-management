            {
              "id": "nivel_educativo", "type": "field", "component": "select",
              "variable": "NivelGradoMasAltoAp", "label": "Nivel educativo", "order": 4, "core": true,
              "options": [
                { "label": "Ninguno", "value": "0" },
                { "label": "Educación Media", "value": "1" },
                { "label": "Educación Básica", "value": "2" }
              ]
            }
          ]
        },
        {
          "id": "especialidad", "type": "field", "component": "select",
          "variable": "Especialidad", "label": "Especialidad", "order": 3, "core": false,
          "dependency": { "field": "GradoMasAlto" },
          "map": { "1": [{ "label": "General", "value": "general" }] }
        }
      ]
    },
    {
      "id": "servicios_basicos", "type": "section", "title": "Servicios Básicos",
